# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional: OpenAI-compatible LLM key for NL extraction, chatbot & business plans.
# When absent, the platform automatically uses deterministic fallback engines,
# so the full demo works offline.
AI_API_KEY=
# Optional overrides
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
